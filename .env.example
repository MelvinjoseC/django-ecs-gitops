# -----------------------------------------------------------------------------
# Django Application Configuration Environment Variables
# -----------------------------------------------------------------------------

# Application Mode: Set to True for local development, False for production/staging
DEBUG=True

# Security: Secret key for session signing, cryptography, etc.
# Generate a secure key for production using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-secret-key-change-in-prod-environments

# Host headers verification. Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database Connection Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# Local Development Tools Configuration (e.g. pgAdmin)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
