# Copy this to terraform.tfvars and fill in your values
# Do NOT commit terraform.tfvars to git

aws_region          = "ap-south-1"
ecr_repository_name = "django-ecs-gitops"
ecs_cluster_name    = "django-app-cluster"
ecs_service_name    = "django-app-service"

vpc_id     = "vpc-xxxxxxxxxxxxxxxxx"
subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]

db_host = "your-rds-endpoint.ap-south-1.rds.amazonaws.com"
db_name = "appdb"

# Get ARNs after running scripts/setup_secrets.sh
secret_key_arn   = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/django-ecs-gitops/secret_key"
db_user_arn      = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/django-ecs-gitops/db_user"
db_password_arn  = "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/django-ecs-gitops/db_password"
