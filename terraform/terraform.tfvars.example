aws_region          = "ap-south-1"
ecr_repository_name = "django-ecs-gitops"
ecs_cluster_name    = "django-app-cluster"
ecs_service_name    = "django-app-service"
image_tag           = "latest"
allowed_hosts       = "localhost,your-domain.com"

# Network Configuration
vpc_id     = "vpc-0123456789abcdef0"
subnet_ids = [
  "subnet-0123456789abcdef1",
  "subnet-0123456789abcdef2"
]

# Database Configuration
db_host = "your-rds-endpoint.rds.amazonaws.com"
db_name = "appdb"

# AWS SSM Parameter ARNs (Created via scripts/setup_secrets.sh)
secret_key_arn  = "arn:aws:ssm:ap-south-1:123456789012:parameter/django-ecs-gitops/secret_key"
db_user_arn     = "arn:aws:ssm:ap-south-1:123456789012:parameter/django-ecs-gitops/db_user"
db_password_arn = "arn:aws:ssm:ap-south-1:123456789012:parameter/django-ecs-gitops/db_password"

# Resource Tags
tags = {
  Project     = "django-ecs-gitops"
  Environment = "production"
  ManagedBy   = "terraform"
}
