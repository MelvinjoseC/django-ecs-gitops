# =============================================================================
# Remote State Configuration (S3 + DynamoDB State Locking)
# Copy this file to backend.tf and customize the values:
#   cp backend.tf.example backend.tf
# =============================================================================

terraform {
  backend "s3" {
    bucket         = "your-company-terraform-state-bucket"
    key            = "django-ecs-gitops/production/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "terraform-state-locks"
    encrypt        = true
  }
}
