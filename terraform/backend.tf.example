# backend.tf.example
# Rename this file to backend.tf and configure it with your S3 bucket and DynamoDB table
# for secure remote state storage and state locking.
#
# Note: You must create the S3 bucket and DynamoDB table prior to running "terraform init".

terraform {
  backend "s3" {
    bucket         = "YOUR-TERRAFORM-STATE-BUCKET-NAME"
    key            = "django-ecs-gitops/terraform.tfstate"
    region         = "ap-south-1"
    encrypt        = true
    dynamodb_table = "YOUR-TERRAFORM-LOCK-TABLE-NAME"
  }
}
